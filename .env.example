ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=kimi-k2.5
# ANTHROPIC_BASE_URL=  # Optional: for Anthropic-compatible services (Kimi, GLM, etc.)
LLM_MAX_TOKENS=8192
# Thinking: auto / enabled / disabled
LLM_THINKING_MODE=enabled
LLM_THINKING_BUDGET=8192
LLM_SHOW_THINKING=true
BASH_TIMEOUT=120
AGENT_MAX_TURNS=300

# Long-term memory review:
# 0 = disable automatic review
# 5 = a practical default for day-to-day use
# The review is triggered after every 5 real user turns, then looks back over
# a recent conversation window. It does NOT summarize only the 5th message.
MEMORY_REVIEW_INTERVAL=5

# Tool-result offloading:
# Large tool outputs are saved under .harness/sessions/<id>/tool-results/
TOOL_RESULT_PERSIST_THRESHOLD=4000
BASH_RESULT_PERSIST_THRESHOLD=2000
TOOL_RESULTS_AGGREGATE_BUDGET=30000

UI_MARKDOWN_CODE_THEME=friendly
UI_MARKDOWN_INLINE_CODE_STYLE=bold cyan
UI_MARKDOWN_CODE_BLOCK_STYLE=cyan
